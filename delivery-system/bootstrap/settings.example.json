{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"/ABSOLUTE/PATH/TO/delivery-system/tools/dq\" hook-pretool" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"/ABSOLUTE/PATH/TO/delivery-system/tools/dq\" hook-stop" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/ABSOLUTE/PATH/TO/delivery-system/tools/dq *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)"
    ]
  }
}
